     Minimal (non-Compose) OmniJaws weather settings. The original Compose
     SettingsActivity was dropped in the headless strip; this restores an
     enable + provider/units/interval screen so weather can actually be turned
     on and configured. Keys map 1:1 to Config.PREF_KEY_*.

     IchthysOS: the location is the shared place from Settings > Guard > Rules > Shared values
     (a trip under way, else the home city; IchthysPlacesService), and only without one this
     device's location. The old custom-location preferences have no UI; the shared place wins
     over them (WeatherUpdateService).
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreference
        android:key="enable"
        android:title="@string/weather_enable_title"
        android:summary="@string/weather_enable_summary"
        android:defaultValue="true" />

    <ListPreference
        android:key="provider"
        android:title="@string/weather_provider_title"
        android:summary="%s"
        android:entries="@array/weather_provider_entries"
        android:entryValues="@array/weather_provider_values"
        android:defaultValue="3"
        android:dependency="enable" />

    <!-- IchthysOS: units are a shared value now (Settings > Guard > Rules > Shared values). -->

    <!-- IchthysOS: where the weather is for; SettingsActivity fills in the active place. -->
    <Preference
        android:key="location_info"
        android:title="@string/weather_location_title"
        android:summary="@string/weather_location_device"
        android:selectable="false"
        android:persistent="false"
        android:dependency="enable" />

    <ListPreference
        android:key="update_interval"
        android:title="@string/weather_interval_title"
        android:summary="%s"
        android:entries="@array/weather_interval_entries"
        android:entryValues="@array/weather_interval_values"
        android:defaultValue="2"
        android:dependency="enable" />

    <ListPreference
        android:key="icon_pack"
        android:title="@string/weather_icon_pack_title"
        android:summary="%s"
        android:entries="@array/weather_icon_pack_entries"
        android:entryValues="@array/weather_icon_pack_values"
        android:defaultValue="org.omnirom.omnijaws.tabler"
        android:dependency="enable" />

</PreferenceScreen>
